# Copy this file to .env.local and fill in your Firebase web app's settings
# (Firebase console → Project settings → Your apps → Web app → SDK setup).
# On Netlify, add the same four variables under Site configuration →
# Environment variables, then redeploy. Leave them empty to run Skilly
# without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local testing only: 1 = use the Firebase emulators (npm run emulators).
VITE_FIREBASE_EMULATORS=
