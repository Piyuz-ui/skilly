{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "skilly",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "skilly-emulators",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "env": {
        "VITE_FIREBASE_EMULATORS": "1",
        "VITE_FIREBASE_API_KEY": "demo-key",
        "VITE_FIREBASE_PROJECT_ID": "demo-skilly",
        "VITE_FIREBASE_AUTH_DOMAIN": "localhost",
        "VITE_FIREBASE_APP_ID": "demo"
      }
    },
    {
      "name": "skilly-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}